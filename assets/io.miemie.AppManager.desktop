[Desktop Entry]
Type=Application
Name=星序应用管理
Comment=查看、搜索、更新和卸载 Ubuntu 应用
Exec=/usr/bin/miemie-app-manager
Icon=/usr/share/icons/hicolor/256x256/apps/io.miemie.AppManager.png
Terminal=false
Categories=Settings;PackageManager;
Keywords=星序;应用;管理;更新;卸载;Xingxu;update;uninstall;
StartupNotify=true
StartupWMClass=io.miemie.AppManager
